<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Success Animation -->

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieSuccess"
        android:layout_width="160dp"
        android:layout_height="130dp"
        android:layout_gravity="center_horizontal"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_fileName="plant"
        app:lottie_speed="1.0" />


    <!-- Success Title -->

    <TextView
        android:id="@+id/tvSuccessTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Order Placed!"
        android:textColor="#2E7D32"
        android:textSize="28sp"
        android:textStyle="bold" />


    <!-- Success Message -->

    <TextView
        android:id="@+id/tvSuccessMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Your order has been placed successfully."
        android:textColor="#555555"
        android:textSize="15sp" />


    <!-- Order ID Card -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        app:cardBackgroundColor="#F1F8E9"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order ID"
                android:textColor="#777777"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="#FL2026001"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- Delivery Message -->

    <TextView
        android:id="@+id/tvDeliveryMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="We'll notify you when your order is ready for delivery."
        android:textColor="#666666"
        android:textSize="13sp" />


    <!-- View My Orders -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewOrders"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="25dp"
        android:text="View My Orders"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#2E7D32"
        app:cornerRadius="12dp" />


    <!-- Continue Shopping -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueShopping"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Continue Shopping"
        android:textColor="#2E7D32"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#FFFFFF"
        app:cornerRadius="12dp"
        app:strokeColor="#2E7D32"
        app:strokeWidth="1dp" />

</LinearLayout>