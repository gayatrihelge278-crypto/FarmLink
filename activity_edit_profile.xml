<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7FAF6">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/arrow_back"
            android:padding="5dp"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Profile"
            android:textColor="#174D24"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="30dp"/>

    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- Profile Photo -->

            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_profile"
                android:scaleType="centerCrop"
                android:background="#E5F2E4"
                android:contentDescription="Profile Photo"
                android:clickable="true"
                android:focusable="true"/>


            <TextView
                android:id="@+id/btnChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:text="Change Photo"
                android:textColor="#21862F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:layout_marginTop="8dp"/>


            <!-- Full Name -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="7dp"/>

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Rahul Sharma"
                android:hint="Enter full name"
                android:textSize="14sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="#FFFFFF"
                android:inputType="textCapWords"/>


            <!-- Mobile -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile Number"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="7dp"/>

            <EditText
                android:id="@+id/etMobile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="+91 9876543210"
                android:hint="Enter mobile number"
                android:textSize="14sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="#FFFFFF"
                android:inputType="phone"/>


            <!-- Email -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="7dp"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="rahul@gmail.com"
                android:hint="Enter email"
                android:textSize="14sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="#FFFFFF"
                android:inputType="textEmailAddress"/>


            <!-- Farm Name -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Farm Name"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="7dp"/>

            <EditText
                android:id="@+id/etFarmName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Green Valley Farm"
                android:hint="Enter farm name"
                android:textSize="14sp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="#FFFFFF"
                android:inputType="textCapWords"/>


            <!-- Farming Category -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Farming Category"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="7dp"/>

            <Spinner
                android:id="@+id/spinnerFarmingCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#FFFFFF"/>


            <!-- Address -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Farm Address"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="7dp"/>

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:text="Amravati, Maharashtra"
                android:hint="Enter farm address"
                android:textSize="14sp"
                android:gravity="top"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:inputType="textMultiLine"/>


            <!-- Save -->

            <TextView
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Save Changes"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#21862F"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="25dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>