<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7FAF6">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/arrow_back"
            android:padding="5dp"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Products"
            android:textColor="#174D24"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="30dp" />

    </LinearLayout>


    <!-- Search -->

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:hint="Search your products..."
        android:textSize="14sp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:singleLine="true"
        android:background="#FFFFFF" />


    <!-- Product List -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/productContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">


            <!-- Product 1 -->

            <LinearLayout
                android:id="@+id/product1"
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/img_3"
                    android:scaleType="centerCrop"
                    android:contentDescription="Tomatoes" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fresh Tomatoes"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vegetables • 30 kg"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹30 / Kg"
                        android:textColor="#21862F"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/btnEditProduct1"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_edit"
                    android:padding="7dp"
                    android:contentDescription="Edit Product" />

            </LinearLayout>


            <!-- Product 2 -->

            <LinearLayout
                android:id="@+id/product2"
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/img_4"
                    android:scaleType="centerCrop"
                    android:contentDescription="Potatoes" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fresh Potatoes"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vegetables • 50 kg"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹25 / Kg"
                        android:textColor="#21862F"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/btnEditProduct2"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_edit"
                    android:padding="7dp"
                    android:contentDescription="Edit Product" />

            </LinearLayout>


            <!-- Product 3 -->

            <LinearLayout
                android:id="@+id/product3"
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/img_5"
                    android:scaleType="centerCrop"
                    android:contentDescription="Onions" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fresh Onions"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vegetables • 40 kg"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹28 / Kg"
                        android:textColor="#21862F"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/btnEditProduct3"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_edit"
                    android:padding="7dp"
                    android:contentDescription="Edit Product" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- Add Product Button -->

    <TextView
        android:id="@+id/btnAddProduct"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_margin="16dp"
        android:text="+  Add New Product"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#21862F" />

</LinearLayout>