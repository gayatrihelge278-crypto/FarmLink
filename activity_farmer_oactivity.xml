<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7FAF6">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/arrow_back"
            android:padding="5dp"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Orders"
            android:textColor="#174D24"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="30dp" />

    </LinearLayout>


    <!-- Order Filter -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:scrollbars="none"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="85dp"
                android:layout_height="36dp"
                android:text="All"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#21862F" />

            <TextView
                android:id="@+id/filterNew"
                android:layout_width="85dp"
                android:layout_height="36dp"
                android:text="New"
                android:textColor="#555555"
                android:textSize="13sp"
                android:gravity="center"
                android:background="#EAF3E9"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/filterAccepted"
                android:layout_width="90dp"
                android:layout_height="36dp"
                android:text="Accepted"
                android:textColor="#555555"
                android:textSize="13sp"
                android:gravity="center"
                android:background="#EAF3E9"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/filterPreparing"
                android:layout_width="95dp"
                android:layout_height="36dp"
                android:text="Preparing"
                android:textColor="#555555"
                android:textSize="13sp"
                android:gravity="center"
                android:background="#EAF3E9"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/filterDelivered"
                android:layout_width="95dp"
                android:layout_height="36dp"
                android:text="Delivered"
                android:textColor="#555555"
                android:textSize="13sp"
                android:gravity="center"
                android:background="#EAF3E9"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- Orders -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- Order 1 -->

            <LinearLayout
                android:id="@+id/order1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Order #FL1024"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/status1"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="New"
                        android:textColor="#D97706"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="#FFF3CD" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer: Rahul Sharma"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tomatoes • 5 Kg"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: ₹150"
                    android:textColor="#21862F"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="7dp" />

                <TextView
                    android:id="@+id/btnViewOrder1"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="View Order"
                    android:textColor="#21862F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#EAF3E9"
                    android:layout_marginTop="12dp" />

            </LinearLayout>


            <!-- Order 2 -->

            <LinearLayout
                android:id="@+id/order2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Order #FL1023"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/status2"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="Preparing"
                        android:textColor="#2563EB"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="#E8F0FF" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer: Priya Patil"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Potatoes • 10 Kg"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: ₹250"
                    android:textColor="#21862F"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="7dp" />

                <TextView
                    android:id="@+id/btnViewOrder2"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="View Order"
                    android:textColor="#21862F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#EAF3E9"
                    android:layout_marginTop="12dp" />

            </LinearLayout>


            <!-- Order 3 -->

            <LinearLayout
                android:id="@+id/order3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Order #FL1022"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="Delivered"
                        android:textColor="#21862F"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="#E3F5E5" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer: Amit Joshi"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Onions • 8 Kg"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: ₹224"
                    android:textColor="#21862F"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="7dp" />

                <TextView
                    android:id="@+id/btnViewOrder3"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="View Order"
                    android:textColor="#21862F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="#EAF3E9"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>